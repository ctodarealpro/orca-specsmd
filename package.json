{
  "name": "orca-specsmd",
  "version": "0.2.0",
  "description": "Plugin do Orca ADE (não oficial) que mostra projetos specs.md FIRE",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:yaml": "esbuild build/yaml-entry.mjs --bundle --format=esm --platform=neutral --minify --legal-comments=inline --outfile=plugin/worker/vendor/yaml.mjs"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.24.2",
    "yaml": "^2.9.1"
  },
  "private": true
}
